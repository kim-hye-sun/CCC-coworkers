
COMMIT_MESSAGE_FILE=$1
COMMIT_MESSAGE=$(cat "$COMMIT_MESSAGE_FILE")

# Jira 티켓 번호와 이모티콘 제거
CLEANED_COMMIT_MESSAGE=$(echo "$COMMIT_MESSAGE" | sed -E 's/^[A-Z]+-[0-9]+ //')
CLEANED_COMMIT_MESSAGE=$(echo "$CLEANED_COMMIT_MESSAGE" | sed -E 's/^(✨|🐛|🔨|📝|💄|🔀|🚚|🎨|♻️|🔥|✅|📦)//')

# 커밋 메시지 형식 검증 (영어 소문자로 시작하고 콜론과 공백 포함 여부)
if ! echo "$CLEANED_COMMIT_MESSAGE" | grep -qE "^[a-z]+: "; then
  echo
  echo "------------------------ERROR------------------------"
  echo "🥵 커밋 메시지는 영어 소문자로 시작하고 콜론과 공백이 뒤따라야 합니다.🥵"
  echo "🍙 <type>(<scope: 선택>): <short summary> 🍙"
  echo "❗️ (현재 커밋 메세지) $CLEANED_COMMIT_MESSAGE ❗️"
  exit 1
fi

# 커밋 메시지 제목 길이 검증
FIRST_LINE=$(echo "$COMMIT_MESSAGE" | head -n 1)
FIRST_LINE_LENGTH=$(echo -n "$FIRST_LINE" | wc -m)

if [ "$FIRST_LINE_LENGTH" -gt 60 ]; then
  echo
  echo "------------------------ERROR------------------------"
  echo "🥵 커밋 메시지의 제목은 60자를 넘을 수 없습니다.🥵"
  echo "❗️❗️ 제목의 길이를 60자 이하로 유지해주세요. ❗️❗️"
  exit 1
fi

echo "🔆 Thanks for keeping the convention 🔆"
