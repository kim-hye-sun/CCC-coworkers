COMMIT_MSG_FILE=$1
ORIGINAL_COMMIT_MSG=$(cat $COMMIT_MSG_FILE)
COMMIT_MSG=$(cat $COMMIT_MSG_FILE)

# 커밋메세지 형식 
# type(scope): summary
COMMIT_MESSAGE_REGEX="^[a-z]+(\([^\)]+\))?: .+"

# ----------------------------------------------------------------------

formmat_commit_message() {
  TYPE=$(echo "$ORIGINAL_COMMIT_MSG" | sed -E 's/^([a-zA-Z ]+)(\([^\)]+\))?:.*/\1/' | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  SCOPE=$(echo "$ORIGINAL_COMMIT_MSG" | sed -E 's/^[a-zA-Z ]+(\(([^\)]+)\))?:.*/\2/')
  SUMMARY=$(echo "$ORIGINAL_COMMIT_MSG" | sed -E 's/^[a-zA-Z ]+(\([^\)]+\))?:[ ]*//; s/[[:space:]]*$//')
  
  COMMIT_MSG="$TYPE($SCOPE): $SUMMARY"
}

validate_and_format_commit_message() {
  if ! echo "$ORIGINAL_COMMIT_MSG" | grep -qE "$COMMIT_MESSAGE_REGEX"; then
    formmat_commit_message

    echo "형식에 맞도록 커밋메세지를 수정했어요. 😺 $COMMIT_MSG 😺"
    echo "$COMMIT_MSG" > "$COMMIT_MSG_FILE"
  fi

  # 형식 검증 후 다시 검증
  if ! echo "$COMMIT_MSG" | grep -qE "$COMMIT_MESSAGE_REGEX"; then
    echo
    echo "------------------------ERROR------------------------"
    echo "🥵 커밋 메시지는 'type(scope): summary' 형식이어야 합니다.🥵"
    echo "🍙 예시: feat(auth): add login feature 🍙"
    echo "❗️ (현재 커밋 메시지) $COMMIT_MSG ❗️"
    exit 1
  fi

  # 커밋 메시지 제목 길이 검증
  FIRST_LINE=$(echo "$COMMIT_MSG" | head -n 1)
  FIRST_LINE_LENGTH=$(echo -n "$FIRST_LINE" | wc -m)

  if [ "$FIRST_LINE_LENGTH" -gt 50 ]; then
    echo
    echo "------------------------ERROR------------------------"
    echo "🥵 커밋 메시지의 제목은 50자를 넘을 수 없습니다.🥵"
    echo "❗️❗️ (현재) $FIRST_LINE_LENGTH 글자 ❗️❗️"
    exit 1
  fi
}

# Merge로 시작하는 커밋은 형식 검사를 생략
if ! echo "$ORIGINAL_COMMIT_MSG" | grep -q "^Merge"; then
  validate_and_format_commit_message
fi


# ---------------------------------------------------------------------

echo
echo '✈️ ✈️ ✈️ 🛫 wait add jira issue number & Gitmoji 🛬 ✈️ ✈️ ✈️'

BRANCH_NAME=$(git symbolic-ref -q HEAD)
BRANCH_NAME=${BRANCH_NAME##*/} # Remove everything before the last /
ISSUE_TICKET=$(echo "$BRANCH_NAME" | sed -n 's/^\([A-Z]*-[0-9]*\)-\(.*\)$/\1/p')

# 이모지 맵
case "$COMMIT_MSG" in
    feat*) EMOJI="✨";;
    fix*|hotfix*) EMOJI="🐛";;
    build*) EMOJI="🔨";;
    docs*) EMOJI="📝";;
    design*) EMOJI="💄";;
    merge*|Merge*) EMOJI="🔀";;
    rename*) EMOJI="🚚";;
    style*) EMOJI="🎨";;
    refactor*) EMOJI="♻️";;
    remove*) EMOJI="🔥";;
    test*) EMOJI="✅";;
    chore*) EMOJI="📦";;
    *) 
      echo
      echo "------------------------ERROR------------------------"
      echo "🥵 허용되는 커밋메세지 타입을 입력해주세요(대소문자구분) 🥵"
      echo "👌 feat,fix,hotfix,build,docs,design,merge,rename,style,refactor,remove,test,chore 👌"
      echo
      exit 1
      ;;
esac


if [ -n "$EMOJI" ]; then
    COMMIT_MSG="$EMOJI $COMMIT_MSG"
fi

if [ -n "$ISSUE_TICKET" ]; then
  COMMIT_MSG="$ISSUE_TICKET $COMMIT_MSG"
   echo "          Jira 티켓 번호: $ISSUE_TICKET / emoji $EMOJI      "
else
    COMMIT_MSG="$COMMIT_MSG"
    echo "            Jira 티켓 번호: ⚠️ 없어요 ⚠️ / emoji $EMOJI      "
fi


echo "$COMMIT_MSG" > $COMMIT_MSG_FILE
echo
echo "🔆 Thanks for keeping the convention 🔆"
echo