echo
echo '✈️ ✈️ ✈️ 🛫 wait add jira issue number & EMOJI 🛬 ✈️ ✈️ ✈️'

BRANCH_NAME=$(git symbolic-ref -q HEAD)
BRANCH_NAME=${BRANCH_NAME##*/} # Remove everything before the last /
ISSUE_TICKET=$(echo "$BRANCH_NAME" | sed -n 's/^\([A-Z]*-[0-9]*\)-\(.*\)$/\1/p')

  # Read the commit message from the temporary file
  COMMIT_MSG_FILE=$1
  ORIGINAL_COMMIT_MSG=$(cat $COMMIT_MSG_FILE)
  COMMIT_MSG=$(cat $COMMIT_MSG_FILE)

  # 이모지 맵
  case "$ORIGINAL_COMMIT_MSG" in
    feat*) EMOJI="✨";;
    fix*|!HOTFIX*) EMOJI="🐛";;
    build*) EMOJI="🔨";;
    docs*) EMOJI="📝";;
    design*) EMOJI="💄";;
    merge*) EMOJI="🔀";;
    rename*) EMOJI="🚚";;
    style*) EMOJI="🎨";;
    refactor*) EMOJI="♻️";;
    remove*) EMOJI="🔥";;
    test*) EMOJI="✅";;
    chore*) EMOJI="📦";;
    *) 
      echo
      echo "------------------------ERROR------------------------"
      echo "🥵 허용되는 커밋메세지 타입을 입력해주세요(대소문자구분) 🥵"
      echo "👌 feat,fix,!HOTFIX,build,docs,design,merge,rename,style,refactor,remove,test,chore 👌"
      exit 1
      ;;
  esac

  # 이모지 추가
  if [ -n "$EMOJI" ]; then
    COMMIT_MSG="$EMOJI $COMMIT_MSG"
  fi


# Check if ISSUE_TICKET is not empty
if [ -n "$ISSUE_TICKET" ]; then
  # Prepend Jira 이슈 티켓 번호 to the commit message with a hyphen and remove the space
  COMMIT_MSG="$ISSUE_TICKET $COMMIT_MSG"
   echo "       Jira 이슈 티켓 번호: $ISSUE_TICKET / emoji $EMOJI      "
   echo
else
    COMMIT_MSG="$COMMIT_MSG"
    echo "⚠️ ⚠️ Jira 이슈 티켓 번호가 없어요 ⚠️ ⚠️ "
    echo
fi

  echo "$COMMIT_MSG" > $COMMIT_MSG_FILE

